{
  "name": "tailwind-qr-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build:cli && vitest run tests",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "build:cli": "node scripts/build-cli.mjs",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/browser": "4.3.3",
    "@types/pngjs": "^6.0.5",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "codejar": "^4.3.0",
    "dompurify": "^3.3.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prismjs": "^1.30.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "description": "Create a single QR sheet from HTML and CSS for Tailwind QR Playground",
  "license": "MIT",
  "bin": {
    "tailwind-qr": "cli-dist/index.mjs"
  },
  "files": [
    "cli-dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kght6123/tailwind-qr-playground.git"
  }
}
